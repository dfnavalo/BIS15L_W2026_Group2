library(shiny)
ui <- fluidPage(
selectInput("y",
"Select Measurement of Time",
choices=c("hour",
"dow",
"month",
"moonphase"),
selected="hour"),
plotOutput("plot", width="600px", height= "500px")
)
server <- function(input, output, session) {
output$plot <- renderPlot({
surgery %>%
count(mort30) %>%
ggplot(aes(x = count(mort30),
y = .data[[input$y]],
fill = mort30)) +
geom_boxplot(alpha = 0.75) +
labs(title = "Number of Deaths at Various Measurements of Time",
x = "Number of Deaths",
fill = "Number of Deaths") +
theme_minimal()
})
}
shinyApp(ui, server)
