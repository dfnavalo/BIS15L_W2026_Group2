y= "Number of Deaths",)+
theme_minimal()
View(surgery)
names(ahrq_ccs)
library(tidyverse)
library(shiny)
library(shinythemes)
library(janitor)
surgery <- read_csv("data/surgery.csv") %>%
clean_names()
names(surgery)
surgery %>%
filter(race!="NA") %>%
group_by(race) %>%
summarise(
n = n(),
min_age=min(age, na.rm = T),
max_age=max(age, na.rm = T),
mean_age = mean(age, na.rm = T),
median_age = median(age, na.rm = T)
) %>%
arrange(desc(n))
surgery %>%
group_by(mort30) %>%
summarise(
mean_age = mean(age, na.rm = T),
sd_age = sd(age, na.rm = T),
n = n()
)
surgery %>%
group_by(month, mort30) %>%
summarise(
mean_age = mean(age, na.rm = T),
n = n()
)
surgery %>%
filter(gender!="NA") %>%
count(gender)
surgery %>%
filter(gender != "NA") %>%
count(gender) %>%
ggplot(aes(x = gender, y = n, fill = gender)) +
geom_col(fill= "turquoise4") +
labs(title = "Number of Males and Females",
x = "Gender",
y = "Count")
surgery %>%
filter(gender != "NA") %>%
count(gender, mort30)
surgery %>%
filter(gender != "NA") %>%
group_by(gender) %>%
summarize(mortality = sum(mort30 == "Yes", na.rm = T)) %>%
ggplot(aes(x = gender, y = mortality)) +
geom_col(fill = "turquoise4", color = "black", alpha =0.9) +
labs(title = "Deaths by Gender",
x = "Gender",
y = "Number of Deaths")+
theme_minimal()
surgery %>%
filter(month != "NA") %>%
mutate(month = factor(month, c("Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"))) %>%
group_by(month) %>%
summarize(mortality = sum(mort30 == "Yes", na.rm = T)) %>%
arrange(month)
surgery %>%
filter(month != "NA") %>%
mutate(month = factor(month, c("Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"))) %>%
group_by(month) %>%
summarize(mortality = sum(mort30 == "Yes", na.rm = T)) %>%
ggplot(aes(x = month, y = mortality)) +
geom_col(fill = "turquoise4", color = "black", alpha = 0.8) +
theme_minimal()+
labs(title = "Deaths by Month",
x = "Month",
y = "Number of Deaths")
surgery %>%
filter(mort30 == "Yes") %>%
select(baseline_cancer, baseline_cvd, baseline_dementia,
baseline_diabetes, baseline_digestive,
baseline_osteoart, baseline_psych,
baseline_pulmonary) %>%
summarise_all(~sum(. == "Yes", na.rm = T))
surgery %>%
filter(mort30 == "Yes") %>%
select(baseline_cancer, baseline_cvd, baseline_dementia,
baseline_diabetes, baseline_digestive,
baseline_osteoart, baseline_psych,
baseline_pulmonary) %>%
summarise_all(~sum(. == "Yes", na.rm = TRUE)) %>%
pivot_longer(everything(),
names_to = "complication",
values_to = "deaths") %>%
ggplot(aes(x = reorder(complication, deaths), y = deaths)) +
geom_col(fill= "turquoise4", color ="black", alpha = 0.9) +
coord_flip() +
labs(title = "Deaths by Baseline Complication",
x = "Complication",
y = "Number of Deaths")+
theme_minimal()
surgery %>%
filter(asa_status!="NA") %>%
group_by(asa_status) %>%
summarise(mortality_rate = mean(mort30 == "Yes", na.rm = T))
surgery %>%
filter(asa_status != "NA") %>%
group_by(asa_status) %>%
summarize(mortality = sum(mort30 == "Yes", na.rm = T)) %>%
ggplot(aes(x = asa_status, y = mortality)) +
geom_col(fill = "turquoise4", color = "black", alpha = 0.8) +
labs(title = "Death Count Based on ASA Status", x = "ASA Status", y = "Number of Deaths")+ theme_minimal()
surgery <- surgery %>%
mutate(high_risk = asa_status %in% c("III", "IV", "V"),
hour_group = floor(hour))
surgery %>%
group_by(high_risk, hour_group) %>%
summarise(
mortality_rate = mean(mort30 == "Yes", na.rm = T),
.groups = "drop"
) %>%
ggplot(aes(x = hour_group, y = mortality_rate, color = high_risk)) +
geom_point(size = 2) +
geom_line(linewidth = 1) +
labs(
title = "Mortality Rate by Hour for High-Risk Patients",
x = "Hour of Surgery",
y = "Mortality Rate"
) +
theme_minimal()
moon <- surgery %>%
group_by(moonphase) %>%
summarize(
mortality_rate = mean(mort30 == "Yes", na.rm = T),
n = n(),
.groups = "drop")
moon %>%
ggplot(aes(x = moonphase,
y = mortality_rate,
group = 1)) +
geom_point(size = 3, color = "steelblue") +
geom_line(color = "steelblue", linewidth = 1) +
theme_minimal() +
scale_y_continuous(labels = scales::percent) +
labs(
title = "Mortality Rate by Moonphase",
x = NULL,
y = "Mortality Rate"
)
moon2 <- surgery %>%
group_by(moonphase) %>%
summarize(mortality = sum(mort30 == "Yes", na.rm = T))
moon2 %>%
ggplot(aes(x = moonphase,
y = mortality,
fill = moonphase))+
geom_col(fill = "steelblue", color = "black", alpha = 0.8)+
theme_minimal()+
labs(title = "Death Count For Each Moonphase",
x = "Phase of Moon",
y = "Number of Deaths")
surgery %>%
filter(asa_status!="NA") %>%
ggplot(aes(x=asa_status))+
geom_bar(color="black", fill = "steelblue", alpha =0.8 )+
labs(title="ASA Status",
x="ASA",
y= NULL)+
theme_minimal()
